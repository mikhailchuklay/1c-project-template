УстановитьПривилегированныйРежим(Истина); Удалено = 0; Ошибок = 0; Пропущено = 0; Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ __BATCH__ Ссылка ИЗ Документ.ЭлектронноеПисьмоВходящее"); Выборка = Запрос.Выполнить().Выбрать(); Пока Выборка.Следующий() Цикл Попытка ДокОбъект = Выборка.Ссылка.ПолучитьОбъект(); Если ДокОбъект = Неопределено Тогда Пропущено = Пропущено + 1; Иначе ДокОбъект.Удалить(); Удалено = Удалено + 1; КонецЕсли; Исключение Ошибок = Ошибок + 1; КонецПопытки; КонецЦикла; З2 = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) К ИЗ Документ.ЭлектронноеПисьмоВходящее"); Ост = З2.Выполнить().Выгрузить()[0].К; Результат = "deleted=" + Удалено + ";skipped=" + Пропущено + ";errors=" + Ошибок + ";left=" + Ост;
