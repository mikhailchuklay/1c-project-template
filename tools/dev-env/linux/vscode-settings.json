{
    "language-1c-bsl.autoDetect": "off",
    "files.watcherExclude": {
        "**/src/cf/**": true,
        "**/oscript_modules/**": true,
        "**/build/**": true
    },
    "1c-platform-tools.ipc.enabled": true,
    "1c-platform-tools.ipc.port": 40241,
    "1c-platform-tools.ipc.token": "",
    "1c-platform-tools.defaultEnvProfile": "local",
    "1c-platform-tools.useIbcmd": true,
    "1c-platform-tools.platformVersion": "8.5.1.1343",
    "1c-platform-tools.vrunner.initSettingsPath": "tools/vrunner.init.json",
    "1c-platform-tools.paths.cf": "src/cf",
    "1c-platform-tools.paths.cfe": "src/cfe",
    "1c-platform-tools.paths.out": "build/out",
    "1c-platform-tools.server.debug": true
}
