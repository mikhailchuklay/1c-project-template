#Область ОписаниеПеременных

Перем Исполнитель;

#КонецОбласти

#Область ОбработчикиСобытийФормы

Процедура ПриОткрытии()

	Заголовок = "thick-client-check";
	ПутьJSON = СокрЛП(ПараметрЗапуска);
	ФайлJSON = Новый Файл(ПутьJSON);
	Каталог = ФайлJSON.Путь;
	Если Прав(Каталог, 1) <> "/" И Прав(Каталог, 1) <> "\" Тогда
		Каталог = Каталог + "/";
	КонецЕсли;
	Чтение = Новый ЧтениеТекста(Каталог + "executor.path", КодировкаТекста.UTF8);
	ПутьОбработки = СокрЛП(Чтение.Прочитать());
	Чтение.Закрыть();
	Исполнитель = ВнешниеОбработки.Создать(ПутьОбработки);
	Исполнитель.НачатьСценарий();
	Исполнитель.ПродолжитьСценарий();
	ПодключитьОбработчикОжидания("ШагОжидания", 1);

КонецПроцедуры

#КонецОбласти

