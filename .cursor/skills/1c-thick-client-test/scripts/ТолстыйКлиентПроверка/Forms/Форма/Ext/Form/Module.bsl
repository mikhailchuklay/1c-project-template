#Область СлужебныеПроцедурыИФункции

Процедура ШагОжидания()

	Если Исполнитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Исполнитель.ПродолжитьСценарий();

КонецПроцедуры

#КонецОбласти
