#Область ОписаниеПеременных

Перем КаталогПрогона;
Перем Шаги;
Перем ИндексШага;
Перем Фаза;
Перем Результаты;
Перем МоментСтарта;
Перем МоментШага;
Перем ОжиданиеДо;
Перем ПопыткиСбора;
Перем ФормаШага;
Перем ТекущийРезультат;
Перем Занят;
Перем Закончен;
Перем ВызовОбъект;
Перем ВызовМакет;
Перем ВызовАргумент1;
Перем ВызовАргумент2;
Перем ВызовАргумент3;
Перем Сборщики;
Перем ИмяФайлаШага;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Готовит состояние прогона. Вызывается обычной формой до обработчика ожидания.
//
Процедура НачатьСценарий() Экспорт

	Занят = Ложь;
	Закончен = Ложь;
	Фаза = "";
	ИндексШага = 0;

КонецПроцедуры

// Один такт сценария: печать, отчёт, ожидание снимка, журнал.
// Форма вызывает процедуру обработчиком ожидания.
//
Процедура ПродолжитьСценарий() Экспорт

	Если Закончен Или Занят Тогда
		Возврат;
	КонецЕсли;
	Занят = Истина;
	Попытка
		Если Шаги = Неопределено Тогда
			ИнициализироватьСценарий();
		КонецЕсли;
		Если Фаза = "снимок" Тогда
			Если ФайлСуществует(ИмяМаркераСнимка()) Тогда
				ЗакрытьФормуШага();
				ЗавершитьТекущийШаг("PASS", "");
			КонецЕсли;
		ИначеЕсли Фаза = "ожидание" Тогда
			Если ТекущаяДата() >= ОжиданиеДо Тогда
				ЗавершитьТекущийШаг("PASS", "");
			КонецЕсли;
		ИначеЕсли Фаза = "сбор" Тогда
			Таб = ЗабратьПечатныйДокумент();
			Если ТипЗнч(Таб) = Тип("ТабличныйДокумент") Тогда
				СохранитьТабличныйДокумент(Таб, ТекущийРезультат, ИмяФайлаШага);
				ЗавершитьТекущийШаг(СтатусПослеСохранения(ТекущийРезультат), ТекстПроблемыСохранения(ТекущийРезультат));
			Иначе
				ПопыткиСбора = ПопыткиСбора + 1;
				Если ПопыткиСбора > 15 Тогда
					ЗавершитьТекущийШаг("FAIL", "Табличный документ печатной формы не получен");
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ИндексШага >= Шаги.Количество() Тогда
			ЗавершитьПрогон("");
		Иначе
			ВыполнитьТекущийШаг();
		КонецЕсли;
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если ТекущийРезультат = Неопределено Тогда
			ЗавершитьПрогон(ТекстОшибки);
		Иначе
			ЗавершитьТекущийШаг("FAIL", ТекстОшибки);
		КонецЕсли;
	КонецПопытки;
	Занят = Ложь;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ИнициализироватьСценарий()

	МоментСтарта = ТекущаяДата();
	Результаты = Новый Массив;
	ПутьJSON = СокрЛП(ПараметрЗапуска);
	Если ПустаяСтрока(ПутьJSON) Тогда
		ВызватьИсключение "ПараметрЗапуска (/C) не задан: ожидается путь к JSON сценария";
	КонецЕсли;
	ФайлJSON = Новый Файл(ПутьJSON);
	Если Не ФайлJSON.Существует() Тогда
		ВызватьИсключение "Файл сценария не найден: " + ПутьJSON;
	КонецЕсли;
	КаталогПрогона = ФайлJSON.Путь;
	Если Прав(КаталогПрогона, 1) <> "/" И Прав(КаталогПрогона, 1) <> "\" Тогда
		КаталогПрогона = КаталогПрогона + "/";
	КонецЕсли;
	ЗаписатьТекстФайла(КаталогПрогона + "phase", "running");
	Инфо = Новый СистемнаяИнформация;
	ЗаписатьТекстФайла(КаталогПрогона + "diag.txt",
		"mode=" + Строка(ТекущийРежимЗапуска()) + Символы.ПС
		+ "platform=" + Инфо.ВерсияПриложения + Символы.ПС
		+ "user=" + ИмяПользователя() + Символы.ПС);
	Чтение = Новый ЧтениеТекста(ПутьJSON, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Корень = ПрочитатьJSONПростой(Текст);
	Если ТипЗнч(Корень) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Корень сценария должен быть объектом JSON";
	КонецЕсли;
	Шаги = Корень.Получить("steps");
	Если ТипЗнч(Шаги) <> Тип("Массив") Тогда
		ВызватьИсключение "В сценарии нет массива steps";
	КонецЕсли;

КонецПроцедуры

Процедура ВыполнитьТекущийШаг()

	Шаг = Шаги[ИндексШага];
	МоментШага = ТекущаяДата();
	ТекущийРезультат = Новый Соответствие;
	ТекущийРезультат.Вставить("index", ИндексШага);
	ТекущийРезультат.Вставить("action", СтрокаШага(Шаг, "action"));
	ТекущийРезультат.Вставить("status", "FAIL");
	ТекущийРезультат.Вставить("files", Новый Массив);
	Действие = СтрокаШага(Шаг, "action");
	Если Действие = "print" Тогда
		ШагПечать(Шаг);
	ИначеЕсли Действие = "report" Тогда
		ШагОтчет(Шаг);
	ИначеЕсли Действие = "open_form" Тогда
		ШагОткрытьФорму(Шаг);
	ИначеЕсли Действие = "wait" Тогда
		Секунды = ЧислоШага(Шаг, "seconds");
		ОжиданиеДо = ТекущаяДата() + Секунды;
		Фаза = "ожидание";
	Иначе
		ВызватьИсключение "Неизвестное действие: " + Действие;
	КонецЕсли;

КонецПроцедуры

Процедура ШагПечать(Шаг)

	Ссылка = НайтиСсылкуОбъекта(Шаг);
	Если ЭтоДа(Шаг.Получить("invoice")) Тогда
		Ссылка = УчетНДС.НайтиПодчиненныйСчетФактуру(Ссылка, "СчетФактураВыданный");
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			ВызватьИсключение "Не найден подчинённый документ СчетФактураВыданный";
		КонецЕсли;
		ТекущийРезультат.Вставить("invoice_ref", Строка(Ссылка));
	КонецЕсли;
	ОбъектПечати = Ссылка.ПолучитьОбъект();
	ИмяМакета = СтрокаШага(Шаг, "layout");
	Если ПустаяСтрока(ИмяМакета) Тогда
		ИмяМакета = ПервыйКлючМакета(ОбъектПечати);
	КонецЕсли;
	ИмяМетода = СтрокаШага(Шаг, "method");
	ИмяМодуля = СтрокаШага(Шаг, "module");
	ИмяФайлаШага = ИмяАртефакта(Шаг, "print");
	Сборщики = Новый Массив;
	КлючМакета = "";
	Если Не ПустаяСтрока(ИмяМакета) Тогда
		КлючМакета = РазрешитьКлючМакета(ОбъектПечати, ИмяМакета);
		ТекущийРезультат.Вставить("layout_key", КлючМакета);
	КонецЕсли;
	Таб = Неопределено;
	Если Не ПустаяСтрока(ИмяМодуля) Тогда
		Таб = ВызватьУказанныйМетод(ОбъектПечати, ИмяМодуля, ИмяМетода, КлючМакета);
	ИначеЕсли Не ПустаяСтрока(ИмяМетода) Тогда
		Таб = ВызватьМетодСАргументами(ПриемникМетода(ОбъектПечати, Шаг), ИмяМетода, АргументыМетода(ОбъектПечати, Шаг, КлючМакета));
	Иначе
		Таб = ПодобратьТабличныйДокумент(ОбъектПечати, КлючМакета);
	КонецЕсли;
	Если ТипЗнч(Таб) = Тип("ТабличныйДокумент") Тогда
		ТекущийРезультат.Вставить("print_path", "method");
	Иначе
		ТекущийРезультат.Вставить("print_path", "form");
		ТекущийРезультат.Вставить("print_path_note", "Запасной путь: процедура Печать открывает форму «Печать документов». В обычном приложении ПолучитьОкна() возвращает Неопределено, поэтому файл с этого пути может не сохраниться.");
		Если Не ПустаяСтрока(КлючМакета) Тогда
			Таб = ТабличныйДокументВнешнейФормы(ОбъектПечати, КлючМакета);
		КонецЕсли;
		Если ТипЗнч(Таб) <> Тип("ТабличныйДокумент") Тогда
			ОбъектПечати.Печать(КлючМакета, 1, Ложь);
			Таб = ТабличныйДокументФормыПечати(Шаг);
			Если ТипЗнч(Таб) <> Тип("ТабличныйДокумент") Тогда
				Таб = ЗабратьПечатныйДокумент();
			КонецЕсли;
		Иначе
			ТекущийРезультат.Вставить("print_path", "external");
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(Таб) = Тип("ТабличныйДокумент") Тогда
		СохранитьТабличныйДокумент(Таб, ТекущийРезультат, ИмяФайлаШага);
		ЗавершитьТекущийШаг(СтатусПослеСохранения(ТекущийРезультат), ТекстПроблемыСохранения(ТекущийРезультат));
	Иначе
		Фаза = "сбор";
		ПопыткиСбора = 0;
	КонецЕсли;

КонецПроцедуры

Процедура ШагОтчет(Шаг)

	ИмяОтчета = ИмяОбъектаМетаданных(Шаг, "Отчет");
	Если ИмяОтчета = "@first" Тогда
		ИмяОтчета = ИмяТиповогоОтчета();
		ТекущийРезультат.Вставить("report", ИмяОтчета);
	КонецЕсли;
	ОтчетОбъект = Отчеты[ИмяОтчета].Создать();
	Попытка
		ОтчетОбъект.УстановитьНачальныеНастройки();
	Исключение
		ТекущийРезультат.Вставить("settings_note", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ПрименитьПериодОтчета(ОтчетОбъект, Шаг);
	ПрименитьНастройкиОтчета(ОтчетОбъект, Шаг);
	Если Не ПустаяСтрока(СтрокаШага(Шаг, "variant")) Тогда
		ВызватьИсключение "Параметр variant для этого отчёта не применён: у универсального отчёта нет варианта СКД";
	КонецЕсли;
	Таб = Новый ТабличныйДокумент;
	ОтчетОбъект.СформироватьОтчет(Таб);
	ИмяФайлаШага = ИмяАртефакта(Шаг, "report");
	СохранитьТабличныйДокумент(Таб, ТекущийРезультат, ИмяФайлаШага);
	ЗавершитьТекущийШаг(СтатусПослеСохранения(ТекущийРезультат), ТекстПроблемыСохранения(ТекущийРезультат));

КонецПроцедуры

Функция ИмяТиповогоОтчета()

	Подходящее = "";
	Для Каждого ОтчетМета Из Метаданные.Отчеты Цикл
		Имя = ОтчетМета.Имя;
		Если Найти(Имя, "Товар") > 0 И Найти(Имя, "Склад") > 0 Тогда
			Возврат Имя;
		КонецЕсли;
		Если ПустаяСтрока(Подходящее) Тогда
			Подходящее = Имя;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Подходящее) Тогда
		ВызватьИсключение "В конфигурации нет отчётов";
	КонецЕсли;
	Возврат Подходящее;

КонецФункции

Процедура ШагОткрытьФорму(Шаг)

	Вид = СтрокаШага(Шаг, "kind");
	Если ПустаяСтрока(Вид) Тогда
		Вид = "object";
	КонецЕсли;
	Если Вид = "main" Тогда
		ИмяФайлаШага = ИмяАртефакта(Шаг, "main");
		ЗапроситьСнимок("root", "");
		Фаза = "снимок";
		Возврат;
	КонецЕсли;
	ИмяФормы = СтрокаШага(Шаг, "form");
	Если Вид = "object" Тогда
		Ссылка = НайтиСсылкуОбъекта(Шаг);
		Если ПустаяСтрока(ИмяФормы) Тогда
			ФормаШага = Ссылка.ПолучитьФорму();
		Иначе
			ФормаШага = Ссылка.ПолучитьФорму(ИмяФормы);
		КонецЕсли;
	ИначеЕсли Вид = "list" Тогда
		ВидМета = ВидМетаданных(Шаг);
		Имя = ИмяОбъектаМетаданных(Шаг, ВидМета);
		Если ВидМета = "Документ" Тогда
			Менеджер = Документы[Имя];
		ИначеЕсли ВидМета = "Справочник" Тогда
			Менеджер = Справочники[Имя];
		Иначе
			ВызватьИсключение "Список поддерживается для документа и справочника";
		КонецЕсли;
		Если ПустаяСтрока(ИмяФормы) Тогда
			ФормаШага = Менеджер.ПолучитьФормуСписка();
		Иначе
			ФормаШага = Менеджер.ПолучитьФорму(ИмяФормы);
		КонецЕсли;
	ИначеЕсли Вид = "report" Тогда
		Имя = ИмяОбъектаМетаданных(Шаг, "Отчет");
		Если ПустаяСтрока(ИмяФормы) Тогда
			ФормаШага = Отчеты[Имя].ПолучитьФорму();
		Иначе
			ФормаШага = Отчеты[Имя].ПолучитьФорму(ИмяФормы);
		КонецЕсли;
	Иначе
		ВызватьИсключение "Неизвестный kind открываемой формы: " + Вид;
	КонецЕсли;
	ФормаШага.Открыть();
	Если Вид = "report" И ЭтоДа(Шаг.Получить("generate")) Тогда
		СформироватьОткрытыйОтчет(ФормаШага, Шаг);
	КонецЕсли;
	ЗаголовокФормы = ФормаШага.Заголовок;
	ДописатьСтроку(КаталогПрогона + "expected-titles.txt", ЗаголовокФормы);
	ИмяФайлаШага = ИмяАртефакта(Шаг, "form");
	ЗапроситьСнимок("window", ЗаголовокФормы);
	Фаза = "снимок";

КонецПроцедуры

Процедура СформироватьОткрытыйОтчет(ФормаОтчета, Шаг)

	Попытка
		ПрименитьПериодОтчета(ФормаОтчета.ОтчетОбъект, Шаг);
	Исключение
		ТекущийРезультат.Вставить("period_note", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Попытка
		ФормаОтчета.ЭлементыФормы.ПолеВводаДатаНач.Значение = ДатаШага(Шаг, "date_from");
		ФормаОтчета.ЭлементыФормы.ПолеВводаДатаКон.Значение = ДатаШага(Шаг, "date_to");
	Исключение
		// Поля периода есть не у каждой формы отчёта.
	КонецПопытки;
	Попытка
		ФормаОтчета.УниверсальныйОтчет.ДатаНач = НачалоДня(ДатаШага(Шаг, "date_from"));
		ФормаОтчета.УниверсальныйОтчет.ДатаКон = КонецДня(ДатаШага(Шаг, "date_to"));
	Исключение
		// Период мог уже быть записан в объект отчёта.
	КонецПопытки;
	Попытка
		ФормаОтчета.ОбновитьОтчет();
		Возврат;
	Исключение
		ТекстПервой = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Попытка
		ФормаОтчета.СформироватьОтчет(ФормаОтчета.ЭлементыФормы.ПолеТабличногоДокументаРезультат);
		Возврат;
	Исключение
		ТекстПервой = ТекстПервой + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Попытка
		ФормаОтчета.КоманднаяПанельФормыСформировать(Неопределено);
	Исключение
		ВызватьИсключение "Не удалось сформировать отчёт на форме: " + ТекстПервой
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура ЗавершитьТекущийШаг(Статус, ТекстОшибки)

	Если ТекущийРезультат = Неопределено Тогда
		ТекущийРезультат = Новый Соответствие;
		ТекущийРезультат.Вставить("index", ИндексШага);
		ТекущийРезультат.Вставить("files", Новый Массив);
	КонецЕсли;
	ТекущийРезультат.Вставить("status", Статус);
	ТекущийРезультат.Вставить("seconds", ТекущаяДата() - МоментШага);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ТекущийРезультат.Вставить("error", ТекстОшибки);
	КонецЕсли;
	Результаты.Добавить(ТекущийРезультат);
	ТекущийРезультат = Неопределено;
	Фаза = "";
	ИндексШага = ИндексШага + 1;
	ЗаписатьРезультатПрогона("");

КонецПроцедуры

Процедура ЗавершитьПрогон(ТекстОшибки)

	Если Закончен Тогда
		Возврат;
	КонецЕсли;
	Закончен = Истина;
	ОтключитьОбработчикОжидания("ПродолжитьСценарий");
	Если Не ПустаяСтрока(ТекстОшибки) И ТекущийРезультат <> Неопределено Тогда
		ТекущийРезультат.Вставить("status", "FAIL");
		ТекущийРезультат.Вставить("error", ТекстОшибки);
		ТекущийРезультат.Вставить("seconds", ТекущаяДата() - МоментШага);
		Результаты.Добавить(ТекущийРезультат);
		ТекущийРезультат = Неопределено;
	ИначеЕсли Не ПустаяСтрока(ТекстОшибки) Тогда
		Аварийный = Новый Соответствие;
		Аварийный.Вставить("index", -1);
		Аварийный.Вставить("action", "startup");
		Аварийный.Вставить("status", "FAIL");
		Аварийный.Вставить("error", ТекстОшибки);
		Аварийный.Вставить("files", Новый Массив);
		Если Результаты = Неопределено Тогда
			Результаты = Новый Массив;
		КонецЕсли;
		Результаты.Добавить(Аварийный);
	КонецЕсли;
	ВыгрузитьХвостЖурнала();
	ЗаписатьРезультатПрогона(ТекстОшибки);
	Если КаталогПрогона <> Неопределено Тогда
		ЗаписатьТекстФайла(КаталогПрогона + "finished", "1");
	КонецЕсли;
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

Процедура ВыгрузитьХвостЖурнала()

	Если КаталогПрогона = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", МоментСтарта);
	Уровни = Новый Массив;
	Уровни.Добавить(УровеньЖурналаРегистрации.Ошибка);
	Уровни.Добавить(УровеньЖурналаРегистрации.Предупреждение);
	Отбор.Вставить("Уровень", Уровни);
	Попытка
		ВыгрузитьЖурналРегистрации(КаталогПрогона + "event-log.xml", Отбор);
	Исключение
		ЗаписатьТекстФайла(КаталогПрогона + "event-log-error.txt",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьРезультатПрогона(ТекстОшибки)

	Если КаталогПрогона = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Инфо = Новый СистемнаяИнформация;
	Корень = Новый Соответствие;
	Корень.Вставить("started", Формат(МоментСтарта, "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Корень.Вставить("platform", Инфо.ВерсияПриложения);
	Корень.Вставить("user", ИмяПользователя());
	Корень.Вставить("mode", Строка(ТекущийРежимЗапуска()));
	Корень.Вставить("steps", Результаты);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Корень.Вставить("fatal", ТекстОшибки);
	КонецЕсли;
	ЗаписатьТекстФайла(КаталогПрогона + "processor-result.json", ВJSON(Корень));

КонецПроцедуры

Функция НайтиСсылкуОбъекта(Шаг)

	ВидМета = ВидМетаданных(Шаг);
	Имя = ИмяОбъектаМетаданных(Шаг, ВидМета);
	Номер = СтрокаШага(Шаг, "number");
	Если ПустаяСтрока(Номер) И ВидМета <> "Справочник" Тогда
		ВызватьИсключение "В шаге не задан number";
	КонецЕсли;
	ИмяТаблицы = ВидМета + "." + Имя;
	Запрос = Новый Запрос;
	Если Номер = "@latest" Тогда
		Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ " + ИмяТаблицы + " КАК Объект";
		Если ЭтоДа(Шаг.Получить("posted")) Тогда
			Текст = Текст + " ГДЕ Объект.Проведен";
		КонецЕсли;
		Текст = Текст + " УПОРЯДОЧИТЬ ПО Объект.Дата УБЫВ";
		Запрос.Текст = Текст;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			ВызватьИсключение "Объект не найден: " + ИмяТаблицы + " @latest";
		КонецЕсли;
		Ссылка = Выборка.Ссылка;
		ТекущийРезультат.Вставить("ref", Строка(Ссылка));
		ТекущийРезультат.Вставить("number", Строка(Ссылка.Номер));
		Возврат Ссылка;
	КонецЕсли;
	Если ВидМета = "Справочник" И ПустаяСтрока(Номер) Тогда
		ВызватьИсключение "Для справочника нужен number (код или наименование не используются: укажите код в number)";
	КонецЕсли;
	Если ВидМета = "Справочник" Тогда
		Текст = "ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ " + ИмяТаблицы + " КАК Объект ГДЕ Объект.Код = &Номер";
	Иначе
		Текст = "ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ " + ИмяТаблицы + " КАК Объект ГДЕ Объект.Номер = &Номер";
		ДатаТочная = ДатаШага(Шаг, "date");
		ДатаНачала = ДатаШага(Шаг, "date_from");
		ДатаКонца = ДатаШага(Шаг, "date_to");
		Если ЗначениеЗаполнено(ДатаТочная) Тогда
			Текст = Текст + " И Объект.Дата МЕЖДУ &ДатаНачала И &ДатаКонца";
			Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаТочная));
			Запрос.УстановитьПараметр("ДатаКонца", КонецДня(ДатаТочная));
		ИначеЕсли ЗначениеЗаполнено(ДатаНачала) Или ЗначениеЗаполнено(ДатаКонца) Тогда
			Текст = Текст + " И Объект.Дата МЕЖДУ &ДатаНачала И &ДатаКонца";
			Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
				ДатаНачала = Дата(1, 1, 1);
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ДатаКонца) Тогда
				ДатаКонца = Дата(3999, 12, 31);
			КонецЕсли;
			Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
			Запрос.УстановитьПараметр("ДатаКонца", КонецДня(ДатаКонца));
		КонецЕсли;
	КонецЕсли;
	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("Номер", Номер);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "Объект не найден: " + ИмяТаблицы + " " + Номер;
	КонецЕсли;
	Ссылка = Выборка.Ссылка;
	Если Выборка.Следующий() Тогда
		ВызватьИсключение "Найдено больше одного объекта: " + ИмяТаблицы + " " + Номер;
	КонецЕсли;
	ТекущийРезультат.Вставить("ref", Строка(Ссылка));
	Возврат Ссылка;

КонецФункции

Функция ПервыйКлючМакета(ОбъектПечати)

	СтруктураФорм = ОбъектПечати.ПолучитьСтруктуруПечатныхФорм();
	Для Каждого КлючИЗначение Из СтруктураФорм Цикл
		Возврат КлючИЗначение.Ключ;
	КонецЦикла;
	ВызватьИсключение "У объекта нет печатных форм";

КонецФункции

Функция РазрешитьКлючМакета(ОбъектПечати, ИмяМакета)

	Если ПустаяСтрока(ИмяМакета) Тогда
		ВызватьИсключение "В шаге print не задан layout";
	КонецЕсли;
	СтруктураФорм = Неопределено;
	Попытка
		СтруктураФорм = ОбъектПечати.ПолучитьСтруктуруПечатныхФорм();
	Исключение
		Возврат ИмяМакета;
	КонецПопытки;
	Если ТипЗнч(СтруктураФорм) <> Тип("Структура") Тогда
		Возврат ИмяМакета;
	КонецЕсли;
	Если СтруктураФорм.Свойство(ИмяМакета) Тогда
		Возврат ИмяМакета;
	КонецЕсли;
	Кандидаты = Новый Массив;
	Для Каждого КлючИЗначение Из СтруктураФорм Цикл
		Если КлючИЗначение.Значение = ИмяМакета Тогда
			Кандидаты.Добавить(КлючИЗначение.Ключ);
		ИначеЕсли Найти(КлючИЗначение.Ключ, ИмяМакета) = 1 Тогда
			Кандидаты.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Если Кандидаты.Количество() = 1 Тогда
		Возврат Кандидаты[0];
	КонецЕсли;
	Если Кандидаты.Количество() > 1 Тогда
		ВызватьИсключение "Макету """ + ИмяМакета + """ соответствует несколько печатных форм";
	КонецЕсли;
	Возврат ИмяМакета;

КонецФункции

Функция ТабличныйДокументВнешнейФормы(ОбъектПечати, КлючМакета)

	Дерево = Неопределено;
	Попытка
		СтруктураФорм = ОбъектПечати.ПолучитьСтруктуруПечатныхФорм();
	Исключение
		СтруктураФорм = Новый Структура;
	КонецПопытки;
	Попытка
		Дерево = УниверсальныеМеханизмы.ПолучитьДеревоМакетовПечати(
			ОбъектПечати.Ссылка, СтруктураФорм, Неопределено, Неопределено, Ложь);
	Исключение
		ТекущийРезультат.Вставить("print_tree", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	СтрокаМакета = Дерево.Строки.Найти(КлючМакета, "Имя");
	Если СтрокаМакета = Неопределено Тогда
		СтрокаМакета = Дерево.Строки.Найти(КлючМакета, "Текст");
	КонецЕсли;
	Если СтрокаМакета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Расшифровка = СтрокаМакета.Расшифровка;
	Если ТипЗнч(Расшифровка) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ВнешняяСсылка = Неопределено;
	Если Не Расшифровка.Свойство("СсылкаНаВнешнююОбработку", ВнешняяСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВнешняяСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТекущийРезультат.Вставить("external_print", Строка(ВнешняяСсылка));
	Таб = УниверсальныеМеханизмы.НапечататьВнешнююФорму(ОбъектПечати.Ссылка, Расшифровка);
	Если ТипЗнч(Таб) <> Тип("ТабличныйДокумент") Тогда
		ВызватьИсключение "Внешняя печатная форма не вернула табличный документ: " + Строка(ВнешняяСсылка);
	КонецЕсли;
	Возврат Таб;

КонецФункции

Функция ПриемникМетода(ОбъектПечати, Шаг)

	Цель = НРег(СтрокаШага(Шаг, "target"));
	Если Цель = "manager" Или Цель = "менеджер" Тогда
		Возврат МенеджерОбъекта(ОбъектПечати);
	КонецЕсли;
	Возврат ОбъектПечати;

КонецФункции

Функция МенеджерОбъекта(ОбъектПечати)

	Имя = ОбъектПечати.Метаданные().Имя;
	ПолноеИмя = ОбъектПечати.Метаданные().ПолноеИмя();
	Если Найти(ПолноеИмя, "Документ.") = 1 Тогда
		Возврат Документы[Имя];
	ИначеЕсли Найти(ПолноеИмя, "Справочник.") = 1 Тогда
		Возврат Справочники[Имя];
	ИначеЕсли Найти(ПолноеИмя, "Отчет.") = 1 Тогда
		Возврат Отчеты[Имя];
	КонецЕсли;
	ВызватьИсключение "Менеджер для этого объекта не поддерживается: " + ПолноеИмя;

КонецФункции

Функция АргументыМетода(ОбъектПечати, Шаг, КлючМакета)

	Описание = Шаг.Получить("args");
	Готовые = Новый Массив;
	Если Описание = Неопределено Тогда
		Возврат Готовые;
	КонецЕсли;
	Если ТипЗнч(Описание) <> Тип("Массив") Тогда
		ВызватьИсключение "args должен быть массивом";
	КонецЕсли;
	Для Каждого Аргумент Из Описание Цикл
		Готовые.Добавить(ЗначениеАргумента(ОбъектПечати, Аргумент, КлючМакета));
	КонецЦикла;
	Возврат Готовые;

КонецФункции

Функция ЗначениеАргумента(ОбъектПечати, Аргумент, КлючМакета)

	Если ТипЗнч(Аргумент) <> Тип("Соответствие") Тогда
		Возврат Аргумент;
	КонецЕсли;
	ИмяПроцедуры = "";
	Если Аргумент.Получить("procedure") <> Неопределено Тогда
		ИмяПроцедуры = СокрЛП(Строка(Аргумент.Получить("procedure")));
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяПроцедуры) Тогда
		Возврат РезультатПроцедуры(ОбъектПечати, Аргумент, ИмяПроцедуры);
	КонецЕсли;
	Источник = "";
	Если Аргумент.Получить("source") <> Неопределено Тогда
		Источник = НРег(СокрЛП(Строка(Аргумент.Получить("source"))));
	КонецЕсли;
	Если Источник = "layout" Тогда
		Возврат КлючМакета;
	КонецЕсли;
	Если Источник = "collector" Тогда
		Сборщик = Новый Массив;
		Сборщики.Добавить(Сборщик);
		Возврат Сборщик;
	КонецЕсли;
	Если Источник = "attribute" Тогда
		ИмяРеквизита = СокрЛП(Строка(Аргумент.Получить("name")));
		Если Не ЭтоИдентификаторПути(ИмяРеквизита) Или Найти(ИмяРеквизита, ".") > 0 Тогда
			ВызватьИсключение "Недопустимое имя реквизита: " + ИмяРеквизита;
		КонецЕсли;
		Возврат ОбъектПечати[ИмяРеквизита];
	КонецЕсли;
	ВызватьИсключение "Неизвестный аргумент метода";

КонецФункции

Функция РезультатПроцедуры(ОбъектПечати, Описание, ИмяПроцедуры)

	Если Не ЭтоИдентификаторПути(ИмяПроцедуры) Или Найти(ИмяПроцедуры, ".") > 0 Тогда
		ВызватьИсключение "Недопустимое имя процедуры: " + ИмяПроцедуры;
	КонецЕсли;
	Количество = ЧислоАргумента(Описание.Получить("count"), 1);
	ИндексПараметра = ЧислоАргумента(Описание.Получить("parameter"), 0);
	Если Количество < 1 Или Количество > 2 Тогда
		ВызватьИсключение "Процедура аргумента принимает 1 или 2 параметра";
	КонецЕсли;
	Если ИндексПараметра < 0 Или ИндексПараметра >= Количество Тогда
		ВызватьИсключение "parameter вне числа параметров процедуры";
	КонецЕсли;
	ВызовОбъект = ОбъектПечати;
	ВызовАргумент1 = Неопределено;
	ВызовАргумент2 = Неопределено;
	Если Количество = 1 Тогда
		ТекстВызова = "ВызовОбъект." + ИмяПроцедуры + "(ВызовАргумент1)";
	Иначе
		ТекстВызова = "ВызовОбъект." + ИмяПроцедуры + "(ВызовАргумент1, ВызовАргумент2)";
	КонецЕсли;
	Выполнить(ТекстВызова);
	Если ИндексПараметра = 0 Тогда
		Значение = ВызовАргумент1;
	Иначе
		Значение = ВызовАргумент2;
	КонецЕсли;
	Назначения = Описание.Получить("assign");
	Если ТипЗнч(Значение) = Тип("Структура") И ТипЗнч(Назначения) = Тип("Массив") Тогда
		Для Каждого ИмяРеквизита Из Назначения Цикл
			ИмяРеквизита = СокрЛП(Строка(ИмяРеквизита));
			Если Не ЭтоИдентификаторПути(ИмяРеквизита) Или Найти(ИмяРеквизита, ".") > 0 Тогда
				ВызватьИсключение "Недопустимое имя реквизита: " + ИмяРеквизита;
			КонецЕсли;
			Значение.Вставить(ИмяРеквизита, ОбъектПечати[ИмяРеквизита]);
		КонецЦикла;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ЧислоАргумента(Значение, ПоУмолчанию)

	Если Значение = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Число(СокрЛП(Строка(Значение)));

КонецФункции

Функция ПодобратьТабличныйДокумент(ОбъектПечати, КлючМакета)

	Если ПустаяСтрока(КлючМакета) Или Не ЭтоИдентификаторПути(КлючМакета) Или Найти(КлючМакета, ".") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Имена = Новый Массив;
	Имена.Добавить("Печать" + КлючМакета);
	Имена.Добавить(КлючМакета);
	Приемники = Новый Массив;
	Приемники.Добавить(ОбъектПечати);
	Попытка
		Приемники.Добавить(МенеджерОбъекта(ОбъектПечати));
	Исключение
		// У части объектов менеджера нет. Остаётся модуль объекта.
	КонецПопытки;
	Для Каждого Приемник Из Приемники Цикл
		Для Каждого ИмяМетода Из Имена Цикл
			Таб = Неопределено;
			Попытка
				Таб = ВызватьМетодСАргументами(Приемник, ИмяМетода, Новый Массив);
			Исключение
				ТекстОшибки = НРег(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Если Найти(ТекстОшибки, "не обнаружен") > 0 Или Найти(ТекстОшибки, "недостаточно фактических параметров") > 0 Тогда
					Продолжить;
				КонецЕсли;
				ВызватьИсключение;
			КонецПопытки;
			Если ТипЗнч(Таб) = Тип("ТабличныйДокумент") Тогда
				Возврат Таб;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ВызватьМетодСАргументами(Приемник, ИмяМетода, Аргументы)

	Если Не ЭтоИдентификаторПути(ИмяМетода) Или Найти(ИмяМетода, ".") > 0 Тогда
		ВызватьИсключение "Недопустимое имя метода: " + ИмяМетода;
	КонецЕсли;
	Если Аргументы.Количество() > 3 Тогда
		ВызватьИсключение "У метода не больше трёх аргументов";
	КонецЕсли;
	ВызовОбъект = Приемник;
	ВызовАргумент1 = Неопределено;
	ВызовАргумент2 = Неопределено;
	ВызовАргумент3 = Неопределено;
	ТекстВызова = "ВызовОбъект." + ИмяМетода + "(";
	Если Аргументы.Количество() > 0 Тогда
		ВызовАргумент1 = Аргументы[0];
		ТекстВызова = ТекстВызова + "ВызовАргумент1";
	КонецЕсли;
	Если Аргументы.Количество() > 1 Тогда
		ВызовАргумент2 = Аргументы[1];
		ТекстВызова = ТекстВызова + ", ВызовАргумент2";
	КонецЕсли;
	Если Аргументы.Количество() > 2 Тогда
		ВызовАргумент3 = Аргументы[2];
		ТекстВызова = ТекстВызова + ", ВызовАргумент3";
	КонецЕсли;
	ТекстВызова = ТекстВызова + ")";
	ТекущийРезультат.Вставить("call", ТекстВызова);
	Если Сборщики <> Неопределено И Сборщики.Количество() > 0 Тогда
		Выполнить(ТекстВызова);
		Возврат ТабличныйДокументИзСборщика();
	КонецЕсли;
	Возврат Вычислить(ТекстВызова);

КонецФункции

Функция ТабличныйДокументИзСборщика()

	Для Каждого Сборщик Из Сборщики Цикл
		Для Каждого Элемент Из Сборщик Цикл
			Если ТипЗнч(Элемент) = Тип("ТабличныйДокумент") И Элемент.ВысотаТаблицы > 0 Тогда
				Возврат Элемент;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ВызватьУказанныйМетод(ОбъектПечати, ИмяМодуля, ИмяМетода, ИмяМакета)

	Если Не ЭтоИдентификаторПути(ИмяМетода) Тогда
		ВызватьИсключение "Недопустимое имя метода: " + ИмяМетода;
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяМодуля) И Не ЭтоИдентификаторПути(ИмяМодуля) Тогда
		ВызватьИсключение "Недопустимое имя модуля: " + ИмяМодуля;
	КонецЕсли;
	ВызовОбъект = ОбъектПечати;
	ВызовМакет = ИмяМакета;
	Если ПустаяСтрока(ИмяМодуля) Тогда
		Если ПустаяСтрока(ИмяМакета) Тогда
			ТекстВызова = "ВызовОбъект." + ИмяМетода + "()";
		Иначе
			ТекстВызова = "ВызовОбъект." + ИмяМетода + "(ВызовМакет)";
		КонецЕсли;
	ИначеЕсли ПустаяСтрока(ИмяМакета) Тогда
		ТекстВызова = ИмяМодуля + "." + ИмяМетода + "(ВызовОбъект)";
	Иначе
		ТекстВызова = ИмяМодуля + "." + ИмяМетода + "(ВызовОбъект, ВызовМакет)";
	КонецЕсли;
	ТекущийРезультат.Вставить("call", ТекстВызова);
	Возврат Вычислить(ТекстВызова);

КонецФункции

Процедура ПрименитьПериодОтчета(ОтчетОбъект, Шаг)

	ДатаНачала = ДатаШага(Шаг, "date_from");
	ДатаКонца = ДатаШага(Шаг, "date_to");
	Если Не ЗначениеЗаполнено(ДатаНачала) И Не ЗначениеЗаполнено(ДатаКонца) Тогда
		Возврат;
	КонецЕсли;
	Приемник = ОтчетОбъект;
	Если ОтчетОбъект.Метаданные().Реквизиты.Найти("УниверсальныйОтчет") <> Неопределено Тогда
		Приемник = ОтчетОбъект.УниверсальныйОтчет;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		Приемник.ДатаНач = НачалоДня(ДатаНачала);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаКонца) Тогда
		Приемник.ДатаКон = КонецДня(ДатаКонца);
	КонецЕсли;

КонецПроцедуры

Процедура ПрименитьНастройкиОтчета(ОтчетОбъект, Шаг)

	Настройки = Шаг.Получить("settings");
	Если ТипЗнч(Настройки) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Настройки Цикл
		Если Не ЭтоИдентификаторПути(КлючИЗначение.Ключ) Тогда
			ВызватьИсключение "Недопустимое имя настройки: " + КлючИЗначение.Ключ;
		КонецЕсли;
		Если ОтчетОбъект.Метаданные().Реквизиты.Найти("УниверсальныйОтчет") <> Неопределено
			И ОтчетОбъект.УниверсальныйОтчет.Метаданные().Реквизиты.Найти(КлючИЗначение.Ключ) <> Неопределено Тогда
			ОтчетОбъект.УниверсальныйОтчет[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		Иначе
			ОтчетОбъект[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СохранитьТабличныйДокумент(Таб, Результат, ИмяБезРасширения)

	Каталог = КаталогПрогона;
	ПутьMXL = Каталог + ИмяБезРасширения + ".mxl";
	ПутьTXT = Каталог + ИмяБезРасширения + ".txt";
	ПутьPDF = Каталог + ИмяБезРасширения + ".pdf";
	Таб.Записать(ПутьMXL, ТипФайлаТабличногоДокумента.MXL);
	Таб.Записать(ПутьTXT, ТипФайлаТабличногоДокумента.TXT);
	Результат.Получить("files").Добавить(ИмяБезРасширения + ".mxl");
	Результат.Получить("files").Добавить(ИмяБезРасширения + ".txt");
	Попытка
		Таб.Записать(ПутьPDF, ТипФайлаТабличногоДокумента.PDF);
		Результат.Получить("files").Добавить(ИмяБезРасширения + ".pdf");
	Исключение
		Результат.Вставить("pdf_error", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Высота = Таб.ВысотаТаблицы;
	Результат.Вставить("rows", Высота);
	Текст = ПрочитатьТекстФайла(ПутьTXT);
	Результат.Вставить("nonempty", Не ПустаяСтрока(СокрЛП(Текст)));
	Ожидаемые = Неопределено;
	// expect_text проверяется по шагу, который ещё доступен через замыкание нет —
	// его кладёт вызывающий в результат до вызова, если успел. Смотрим текущий шаг.
	Если ИндексШага < Шаги.Количество() Тогда
		Ожидаемые = Шаги[ИндексШага].Получить("expect_text");
	КонецЕсли;
	Если ТипЗнч(Ожидаемые) = Тип("Массив") Тогда
		Пропущенные = Новый Массив;
		Для Каждого Фрагмент Из Ожидаемые Цикл
			Если Найти(Текст, Строка(Фрагмент)) = 0 Тогда
				Пропущенные.Добавить(Строка(Фрагмент));
			КонецЕсли;
		КонецЦикла;
		Если Пропущенные.Количество() > 0 Тогда
			Результат.Вставить("expect_missing", Пропущенные);
		КонецЕсли;
	КонецЕсли;
	Если Высота = 0 Тогда
		Результат.Вставить("empty_spreadsheet", Истина);
	КонецЕсли;

КонецПроцедуры

Функция ТекстПроблемыСохранения(Результат)

	Пропущенные = Результат.Получить("expect_missing");
	Если ТипЗнч(Пропущенные) = Тип("Массив") И Пропущенные.Количество() > 0 Тогда
		Возврат "В тексте печатной формы нет: " + Склеить(Пропущенные, "; ");
	КонецЕсли;
	Если ЭтоДа(Результат.Получить("empty_spreadsheet")) Или Не ЭтоДа(Результат.Получить("nonempty")) Тогда
		Возврат "Табличный документ пуст";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция СтатусПослеСохранения(Результат)

	Если Результат.Получить("expect_missing") <> Неопределено Тогда
		Возврат "FAIL";
	КонецЕсли;
	Если ЭтоДа(Результат.Получить("empty_spreadsheet")) Или Не ЭтоДа(Результат.Получить("nonempty")) Тогда
		Возврат "FAIL";
	КонецЕсли;
	Возврат "PASS";

КонецФункции

Функция ТабличныйДокументФормыПечати(Шаг)

	ИмяФормы = СтрокаШага(Шаг, "print_form");
	Если ПустаяСтрока(ИмяФормы) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не ЭтоИдентификаторПути(ИмяФормы) Тогда
		ВызватьИсключение "Недопустимое имя формы печати: " + ИмяФормы;
	КонецЕсли;
	ФормаПечати = ПолучитьОбщуюФорму(ИмяФормы);
	Если ФормаПечати = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Таб = Неопределено;
	Попытка
		Таб = ФормаПечати.ПечатныйДокумент;
	Исключение
		Таб = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Таб) = Тип("ТабличныйДокумент") И Таб.ВысотаТаблицы > 0 Тогда
		ТекущийРезультат.Вставить("print_path", "print_form");
		Попытка
			ФормаПечати.Закрыть();
		Исключение
			// Форма могла закрыться сама.
		КонецПопытки;
	КонецЕсли;
	Возврат Таб;

КонецФункции

Функция ЗабратьПечатныйДокумент()

	ОкнаПриложения = Неопределено;
	Попытка
		ОкнаПриложения = ПолучитьОкна();
	Исключение
		ТекущийРезультат.Вставить("print_windows", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	Если ОкнаПриложения = Неопределено Тогда
		ТекущийРезультат.Вставить("print_windows", "ПолучитьОкна() = Неопределено");
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ОкноПриложения Из ОкнаПриложения Цикл
		Содержимое = ОкноПриложения.Содержимое;
		Если Содержимое = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Таб = Неопределено;
		Попытка
			Таб = Содержимое.ПечатныйДокумент;
		Исключение
			Таб = Неопределено;
		КонецПопытки;
		Если ТипЗнч(Таб) <> Тип("ТабличныйДокумент") Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Содержимое.Закрыть();
		Исключение
			// Форма печати могла закрыться сама.
		КонецПопытки;
		Возврат Таб;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Процедура ЗапроситьСнимок(Режим, ЗаголовокОкна)

	УдалитьФайлы(ИмяМаркераСнимка());
	ПутьPNG = КаталогПрогона + ИмяФайлаШага + ".png";
	Тело = Новый Соответствие;
	Тело.Вставить("step", ИндексШага);
	Тело.Вставить("mode", Режим);
	Тело.Вставить("title", ЗаголовокОкна);
	Тело.Вставить("png", ПутьPNG);
	Временный = КаталогПрогона + "snap-request.tmp";
	Приемник = КаталогПрогона + "snap-request.json";
	ЗаписатьТекстФайла(Временный, ВJSON(Тело));
	УдалитьФайлы(Приемник);
	ПереместитьФайл(Временный, Приемник);
	ТекущийРезультат.Получить("files").Добавить(ИмяФайлаШага + ".png");

