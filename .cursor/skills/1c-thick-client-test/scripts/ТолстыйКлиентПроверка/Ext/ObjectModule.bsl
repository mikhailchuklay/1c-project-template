Функция ИмяАртефакта(Шаг, Префикс)

	Части = Новый Массив;
	Части.Добавить("step");
	Части.Добавить(Формат(ИндексШага + 1, "ЧГ=0"));
	Части.Добавить(Префикс);
	Мета = СтрокаШага(Шаг, "metadata");
	Если Не ПустаяСтрока(Мета) Тогда
		Части.Добавить(БезопасноеИмя(Мета));
	КонецЕсли;
	Макет = СтрокаШага(Шаг, "layout");
	Если Не ПустаяСтрока(Макет) Тогда
		Части.Добавить(БезопасноеИмя(Макет));
	КонецЕсли;
	Возврат Склеить(Части, "-");

КонецФункции

Функция БезопасноеИмя(Текст)

	Допустимые = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюяABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
	Результат = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		СимволТекста = Сред(Текст, Индекс, 1);
		Если Найти(Допустимые, СимволТекста) > 0 Тогда
			Результат = Результат + СимволТекста;
		Иначе
			Результат = Результат + "_";
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ВидМетаданных(Шаг)

	Мета = СтрокаШага(Шаг, "metadata");
	Позиция = Найти(Мета, ".");
	Если Позиция = 0 Тогда
		ВызватьИсключение "metadata ожидается в виде Вид.Имя: " + Мета;
	КонецЕсли;
	Вид = Лев(Мета, Позиция - 1);
	Если Вид = "Документ" Или Вид = "Справочник" Или Вид = "Отчет" Тогда
		Возврат Вид;
	КонецЕсли;
	ВызватьИсключение "Неподдерживаемый вид метаданных: " + Вид;

КонецФункции

Функция ИмяОбъектаМетаданных(Шаг, ОжидаемыйВид)

	Мета = СтрокаШага(Шаг, "metadata");
	Если Мета = "Отчет.@first" И ОжидаемыйВид = "Отчет" Тогда
		Возврат "@first";
	КонецЕсли;
	Позиция = Найти(Мета, ".");
	Вид = Лев(Мета, Позиция - 1);
	Имя = Сред(Мета, Позиция + 1);
	Если Вид <> ОжидаемыйВид Тогда
		ВызватьИсключение "Ожидался вид " + ОжидаемыйВид + ", получено " + Мета;
	КонецЕсли;
	Если Не ЭтоИдентификаторПути(Имя) Тогда
		ВызватьИсключение "Недопустимое имя объекта: " + Имя;
	КонецЕсли;
	Возврат Имя;

КонецФункции

Функция СтрокаШага(Шаг, Ключ)

	Значение = Шаг.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ЧислоШага(Шаг, Ключ)

	Значение = Шаг.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) Тогда
		Возврат Число(Значение);
	КонецЕсли;
	Возврат 0;

КонецФункции

Функция ДатаШага(Шаг, Ключ)

	Значение = Шаг.Получить(Ключ);
	Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Если СтрДлина(Значение) < 10 Тогда
		ВызватьИсключение "Дата должна быть в виде ГГГГ-ММ-ДД: " + Значение;
	КонецЕсли;
	Возврат Дата(Число(Лев(Значение, 4)), Число(Сред(Значение, 6, 2)), Число(Сред(Значение, 9, 2)));

КонецФункции

Функция ЭтоДа(Значение)

	Если ТипЗнч(Значение) <> Тип("Булево") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ЭтоИдентификаторПути(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Части = РазделитьТочкой(Текст);
	Буквы = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюяABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_";
	Цифры = Буквы + "0123456789";
	Для Каждого Часть Из Части Цикл
		Если ПустаяСтрока(Часть) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Найти(Буквы, Лев(Часть, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Индекс = 2 По СтрДлина(Часть) Цикл
			Если Найти(Цифры, Сред(Часть, Индекс, 1)) = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция РазделитьТочкой(Текст)

	Части = Новый Массив;
	Остаток = Текст;
	Позиция = Найти(Остаток, ".");
	Пока Позиция > 0 Цикл
		Части.Добавить(Лев(Остаток, Позиция - 1));
		Остаток = Сред(Остаток, Позиция + 1);
		Позиция = Найти(Остаток, ".");
	КонецЦикла;
	Части.Добавить(Остаток);
	Возврат Части;

КонецФункции

Функция ФайлСуществует(Путь)
	Файл = Новый Файл(Путь);
	Возврат Файл.Существует();
КонецФункции

Процедура ЗаписатьТекстФайла(Путь, Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

Процедура ДописатьСтроку(Путь, СтрокаТекста)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, Символы.ПС, Истина);
	Запись.ЗаписатьСтроку(СтрокаТекста);
	Запись.Закрыть();

КонецПроцедуры

Функция ПрочитатьТекстФайла(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция Склеить(Части, Разделитель)

	Результат = "";
	Для Индекс = 0 По Части.ВГраница() Цикл
		Если Индекс > 0 Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + Части[Индекс];
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЭкранироватьJSON(Текст)

	Результат = СтрЗаменить(Текст, "\", "\\");
	Результат = СтрЗаменить(Результат, """", "\""");
	Результат = СтрЗаменить(Результат, Символы.ВК, "\r");
	Результат = СтрЗаменить(Результат, Символы.ПС, "\n");
	Результат = СтрЗаменить(Результат, Символы.Таб, "\t");
	Возврат Результат;

КонецФункции

Функция ВJSON(Значение)

	Если Значение = Неопределено Тогда
		Возврат "null";
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Булево") Тогда
		Если Значение Тогда
			Возврат "true";
		КонецЕсли;
		Возврат "false";
	КонецЕсли;
	Если ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0; ЧРД=.");
	КонецЕсли;
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат """" + ЭкранироватьJSON(Значение) + """";
	КонецЕсли;
	Если ТипЗначения = Тип("Массив") Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(ВJSON(Элемент));
		КонецЦикла;
		Возврат "[" + Склеить(Части, ",") + "]";
	КонецЕсли;
	Если ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("Структура") Тогда
		Части = Новый Массив;
		Для Каждого КлючИЗначение Из Значение Цикл
			Части.Добавить(ВJSON(Строка(КлючИЗначение.Ключ)) + ":" + ВJSON(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат "{" + Склеить(Части, ",") + "}";
	КонецЕсли;
	Возврат ВJSON(Строка(Значение));

КонецФункции

Функция ПрочитатьJSONПростой(Текст)

	Состояние = Новый Структура("Текст, Поз", Текст, 1);
	Если Лев(Текст, 1) = Символ(65279) Тогда
		Состояние.Поз = 2;
	КонецЕсли;
	Значение = РазобратьУзел(Состояние);
	ПропуститьПробелыJSON(Состояние);
	Если Состояние.Поз <= СтрДлина(Состояние.Текст) Тогда
		ВызватьИсключение "Лишние символы в JSON на позиции " + Формат(Состояние.Поз, "ЧГ=0");
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция РазобратьУзел(Состояние)

	ПропуститьПробелыJSON(Состояние);
	СимволТекста = СимволJSON(Состояние);
	Если СимволТекста = "{" Тогда
		Возврат ПрочитатьОбъектJSON(Состояние);
	КонецЕсли;
	Если СимволТекста = "[" Тогда
		Возврат ПрочитатьМассивJSON(Состояние);
	КонецЕсли;
	Если СимволТекста = """" Тогда
		Возврат ПрочитатьСтрокуJSON(Состояние);
	КонецЕсли;
	Если Сред(Состояние.Текст, Состояние.Поз, 4) = "true" Тогда
		Состояние.Поз = Состояние.Поз + 4;
		Возврат Истина;
	КонецЕсли;
	Если Сред(Состояние.Текст, Состояние.Поз, 5) = "false" Тогда
		Состояние.Поз = Состояние.Поз + 5;
		Возврат Ложь;
	КонецЕсли;
	Если Сред(Состояние.Текст, Состояние.Поз, 4) = "null" Тогда
		Состояние.Поз = Состояние.Поз + 4;
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПрочитатьЧислоJSON(Состояние);

КонецФункции

Функция ПрочитатьОбъектJSON(Состояние)

	Объект = Новый Соответствие;
	Состояние.Поз = Состояние.Поз + 1;
	ПропуститьПробелыJSON(Состояние);
	Если СимволJSON(Состояние) = "}" Тогда
		Состояние.Поз = Состояние.Поз + 1;
		Возврат Объект;
	КонецЕсли;
	Пока Истина Цикл
		ПропуститьПробелыJSON(Состояние);
		Если СимволJSON(Состояние) <> """" Тогда
			ВызватьИсключение "Ожидался ключ JSON на позиции " + Формат(Состояние.Поз, "ЧГ=0");
		КонецЕсли;
		Ключ = ПрочитатьСтрокуJSON(Состояние);
		ПропуститьПробелыJSON(Состояние);
		Если СимволJSON(Состояние) <> ":" Тогда
			ВызватьИсключение "Ожидалось двоеточие JSON на позиции " + Формат(Состояние.Поз, "ЧГ=0");
		КонецЕсли;
		Состояние.Поз = Состояние.Поз + 1;
		Объект.Вставить(Ключ, РазобратьУзел(Состояние));
		ПропуститьПробелыJSON(Состояние);
		Если СимволJSON(Состояние) = "," Тогда
			Состояние.Поз = Состояние.Поз + 1;
			Продолжить;
		КонецЕсли;
		Если СимволJSON(Состояние) = "}" Тогда
			Состояние.Поз = Состояние.Поз + 1;
			Прервать;
		КонецЕсли;
		ВызватьИсключение "Ожидалась запятая или } на позиции " + Формат(Состояние.Поз, "ЧГ=0");
	КонецЦикла;
	Возврат Объект;

КонецФункции

Функция ПрочитатьМассивJSON(Состояние)

	Массив = Новый Массив;
	Состояние.Поз = Состояние.Поз + 1;
	ПропуститьПробелыJSON(Состояние);
	Если СимволJSON(Состояние) = "]" Тогда
		Состояние.Поз = Состояние.Поз + 1;
		Возврат Массив;
	КонецЕсли;
	Пока Истина Цикл
		Массив.Добавить(РазобратьУзел(Состояние));
		ПропуститьПробелыJSON(Состояние);
		Если СимволJSON(Состояние) = "," Тогда
			Состояние.Поз = Состояние.Поз + 1;
			Продолжить;
		КонецЕсли;
		Если СимволJSON(Состояние) = "]" Тогда
			Состояние.Поз = Состояние.Поз + 1;
			Прервать;
		КонецЕсли;
		ВызватьИсключение "Ожидалась запятая или ] на позиции " + Формат(Состояние.Поз, "ЧГ=0");
	КонецЦикла;
	Возврат Массив;

КонецФункции

Функция ПрочитатьСтрокуJSON(Состояние)

	Состояние.Поз = Состояние.Поз + 1;
	Результат = "";
	Пока Состояние.Поз <= СтрДлина(Состояние.Текст) Цикл
		СимволТекста = Сред(Состояние.Текст, Состояние.Поз, 1);
		Состояние.Поз = Состояние.Поз + 1;
		Если СимволТекста = "\" Тогда
			Экранирование = Сред(Состояние.Текст, Состояние.Поз, 1);
			Состояние.Поз = Состояние.Поз + 1;
			Если Экранирование = "n" Тогда
				Результат = Результат + Символы.ПС;
			ИначеЕсли Экранирование = "r" Тогда
				Результат = Результат + Символы.ВК;
			ИначеЕсли Экранирование = "t" Тогда
				Результат = Результат + Символы.Таб;
			ИначеЕсли Экранирование = "u" Тогда
				Шестнадцатеричное = Сред(Состояние.Текст, Состояние.Поз, 4);
				Состояние.Поз = Состояние.Поз + 4;
				Результат = Результат + Символ(ЧислоИзШестнадцатеричного(Шестнадцатеричное));
			Иначе
				Результат = Результат + Экранирование;
			КонецЕсли;
		ИначеЕсли СимволТекста = """" Тогда
			Возврат Результат;
		Иначе
			Результат = Результат + СимволТекста;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Незакрытая строка JSON";

КонецФункции

Функция ПрочитатьЧислоJSON(Состояние)

	Начало = Состояние.Поз;
	Допустимые = "0123456789-+.eE";
	Пока Состояние.Поз <= СтрДлина(Состояние.Текст) Цикл
		Если Найти(Допустимые, Сред(Состояние.Текст, Состояние.Поз, 1)) = 0 Тогда
			Прервать;
		КонецЕсли;
		Состояние.Поз = Состояние.Поз + 1;
	КонецЦикла;
	Если Состояние.Поз = Начало Тогда
		ВызватьИсключение "Ожидалось значение JSON на позиции " + Формат(Состояние.Поз, "ЧГ=0");
	КонецЕсли;
	ТекстЧисла = Сред(Состояние.Текст, Начало, Состояние.Поз - Начало);
	Попытка
		Возврат Число(СтрЗаменить(ТекстЧисла, ".", ","));
	Исключение
		Возврат Число(ТекстЧисла);
	КонецПопытки;

КонецФункции

Процедура ПропуститьПробелыJSON(Состояние)

	Пока Состояние.Поз <= СтрДлина(Состояние.Текст) Цикл
		СимволТекста = Сред(Состояние.Текст, Состояние.Поз, 1);
		Если СимволТекста = " " Или СимволТекста = Символы.ПС Или СимволТекста = Символы.ВК Или СимволТекста = Символы.Таб Тогда
			Состояние.Поз = Состояние.Поз + 1;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция СимволJSON(Состояние)

	Если Состояние.Поз > СтрДлина(Состояние.Текст) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Состояние.Текст, Состояние.Поз, 1);

КонецФункции

Функция ЧислоИзШестнадцатеричного(Текст)

	Значение = 0;
	Цифры = "0123456789abcdef";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Позиция = Найти(Цифры, НРег(Сред(Текст, Индекс, 1)));
		Если Позиция = 0 Тогда
			ВызватьИсключение "Неверная hex-последовательность JSON: " + Текст;
		КонецЕсли;
		Значение = Значение * 16 + (Позиция - 1);
	КонецЦикла;
	Возврат Значение;

КонецФункции

#КонецОбласти
